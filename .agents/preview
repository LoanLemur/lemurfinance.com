#!/usr/bin/env bash
set -euo pipefail

mkdir -p .amp

if ! npx astro dev status >/dev/null 2>&1; then
  npm run dev -- --background
fi

for _ in {1..10}; do
  if curl --fail --silent --max-time 1 http://localhost:4321/ >/dev/null; then
    break
  fi
  sleep 0.5
done
curl --fail --silent --max-time 2 http://localhost:4321/ >/dev/null

cloudflared="$(command -v cloudflared || true)"
if [[ -z "$cloudflared" && -x "$HOME/.local/bin/cloudflared" ]]; then
  cloudflared="$HOME/.local/bin/cloudflared"
fi
if [[ -z "$cloudflared" ]]; then
  echo "cloudflared is not installed; run .agents/setup first" >&2
  exit 1
fi

if [[ -f .amp/preview.pid ]] && kill -0 "$(cat .amp/preview.pid)" 2>/dev/null; then
  if [[ -s .amp/preview-url ]]; then
    echo "Remote preview: $(cat .amp/preview-url)"
    exit 0
  fi
else
  rm -f .amp/preview-url .amp/cloudflared.log
  nohup "$cloudflared" tunnel --no-autoupdate --url http://localhost:4321 \
    >.amp/cloudflared.log 2>&1 &
  echo $! >.amp/preview.pid
fi

for _ in {1..20}; do
  preview_url="$(grep -Eom1 'https://[-a-z0-9]+\.trycloudflare\.com' .amp/cloudflared.log || true)"
  if [[ -n "$preview_url" ]]; then
    printf '%s\n' "$preview_url" >.amp/preview-url
    echo "Remote preview: $preview_url"
    exit 0
  fi
  if ! kill -0 "$(cat .amp/preview.pid)" 2>/dev/null; then
    cat .amp/cloudflared.log >&2
    exit 1
  fi
  sleep 0.5
done

echo "Timed out waiting for the remote preview URL. See .amp/cloudflared.log." >&2
exit 1
