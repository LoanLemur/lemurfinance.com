---
import Button from "../components/Button.astro";
import LogoLink from "../components/LogoLink.astro";
import Layout from "../layouts/Layout.astro";

const description = "The page you requested could not be found.";
---

<Layout title="Page Not Found" {description}>
  <div class="flex min-h-screen flex-col">
    <header class="border-separator bg-canvas text-foreground border-b">
      <div
        class="max-w-page mx-auto flex w-full items-center justify-between px-5 py-5 sm:px-8 lg:px-14 lg:py-6"
      >
        <LogoLink />
        <p class="text-label text-muted font-medium uppercase">Error 404</p>
      </div>
    </header>

    <main id="main" tabindex="-1" class="flex flex-1 items-center">
      <section
        class="max-w-page mx-auto grid w-full gap-10 px-5 py-16 sm:px-8 sm:py-20 md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] md:items-center lg:px-14 lg:py-24"
        aria-labelledby="not-found-heading"
      >
        <p
          class="text-brand-text text-[clamp(7rem,17vw,15rem)] leading-[0.8] font-bold tracking-[-0.08em]"
          aria-hidden="true"
        >
          404
        </p>

        <div class="flex max-w-3xl flex-col items-start gap-6">
          <h1
            id="not-found-heading"
            class="text-section font-bold text-balance"
          >
            This page doesn’t exist.
          </h1>
          <p class="text-lead text-muted max-w-2xl">
            The address may be incorrect, or the page may have moved. Return to
            the homepage to keep exploring Lemur.
          </p>
          <Button href="/">Return home</Button>
        </div>
      </section>
    </main>

    <footer class="border-separator bg-canvas text-foreground border-t">
      <div
        class="max-w-page mx-auto flex w-full flex-col gap-8 px-5 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-14"
      >
        <LogoLink size="footer" />
        <nav
          class="text-label text-muted flex flex-wrap gap-x-8 gap-y-3 font-medium uppercase"
          aria-label="Footer navigation"
        >
          <a class="hover:text-foreground transition-colors" href="/terms/">
            Terms
          </a>
          <a class="hover:text-foreground transition-colors" href="/privacy/">
            Privacy
          </a>
        </nav>
      </div>
    </footer>
  </div>
</Layout>
